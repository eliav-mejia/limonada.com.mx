# Copia como .env (ignorado por Git). NUNCA subas valores reales.
# Etapa 1 no usa ninguna clave. Etapa 2 (portal de empresas y pedidos):
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>                 # pública; la seguridad la da RLS
SUPABASE_SERVICE_ROLE_KEY=                   # solo servidor (Worker / Edge Function)
FORM_ENDPOINT=                               # Google Apps Script o Worker que recibe cotizaciones
